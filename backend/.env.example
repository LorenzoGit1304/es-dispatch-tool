# DATABASE VARIABLES
# Local example values:
DB_HOST=localhost
DB_PORT=5432
DB_USER=dispatch_user
DB_PASSWORD=yourpassword
DB_NAME=es_dispatch
PORT=4000

# On Railway, create DB_* values from your Postgres service outputs.
# Example mapping:
# DB_HOST -> PGHOST
# DB_PORT -> PGPORT
# DB_USER -> PGUSER
# DB_PASSWORD -> PGPASSWORD
# DB_NAME -> PGDATABASE

# CLERK AUTH VARIABLES
CLERK_SECRET_KEY=sk_test_your_secret_key
CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key

# FRONTEND ORIGIN(S) - comma separated
# Local example: http://localhost:5173
# Production example: https://app.yourdomain.com
FRONTEND_URL=http://localhost:5173

# Runtime mode
NODE_ENV=development
