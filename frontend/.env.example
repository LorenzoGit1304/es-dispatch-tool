# Clerk publishable key for the current environment
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here

# Backend API base URL
# Local example: http://localhost:4000
# Production example: https://api.yourdomain.com
VITE_API_BASE_URL=http://localhost:4000

# If you deploy on Railway, make sure this points to the deployed backend URL,
# not the Railway frontend URL.
